build/
build-*/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
compile_commands.json
*.o
*.obj
*.a
*.so
*.so.*
*.dll
*.dylib
*.exe

# Qt Creator / IDE-local state
.qtcreator/
*.user
*.user.*
*.autosave
*.pro
*.pro.user

# CMake / Ninja generated files
.ninja_deps
.ninja_log
build.ninja
rules.ninja

