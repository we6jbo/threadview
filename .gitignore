.flatpak-builder/
repo/
flatpak-build/
*.flatpak

# Snap local build artifacts
parts/
prime/
stage/
.snapcraft/
*.snap

# Temporary / editor files
*~
*.swp
*.swo
*.tmp
*.bak
.DS_Store
Thumbs.db

# Logs, crash dumps, and local runtime state
*.log
core
core.*
*.core

# Environment / local secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials*
secrets*
*token*

